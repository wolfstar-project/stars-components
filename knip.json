{
	"$schema": "https://unpkg.com/knip@6.20.0/schema.json",
	"rules": {
		"exports": "off",
		"types": "off",
		"enumMembers": "off"
	},
	"workspaces": {
		".": {
			"entry": ["scripts/*.{mjs,ts}"],
			"project": ["scripts/**/*.{mjs,ts}"],
			"ignoreDependencies": ["@favware/npm-deprecate", "@swc/core", "@types/ws", "cz-conventional-changelog", "golar", "pkg-pr-new"]
		},
		"packages/*": {
			"entry": ["src/index.ts", "src/register.ts", "tests/**/*.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"],
			"ignoreDependencies": ["tslib"]
		},
		"examples/*": {
			"entry": ["src/**/*.{ts,js}"],
			"project": ["src/**/*.{ts,js}"],
			"ignoreDependencies": ["@sapphire/pieces"]
		},
		"examples/basic": {
			"entry": ["src/**/*.ts"],
			"project": ["src/**/*.ts", "tsdown.config.ts"],
			"ignoreDependencies": ["@sapphire/pieces"]
		},
		"examples/with-subcommands": {
			"entry": ["src/**/*.ts"],
			"project": ["src/**/*.ts", "tsdown.config.ts"],
			"ignoreDependencies": ["@sapphire/pieces"]
		},
		"examples/with-i18n": {
			"entry": ["src/**/*.ts"],
			"project": ["src/**/*.ts", "tsdown.config.ts"],
			"ignoreDependencies": ["@sapphire/pieces"]
		},
		"examples/with-testing": {
			"entry": ["src/**/*.ts", "tests/**/*.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "vitest.setup.ts"]
		},
		"examples/with-testing-js": {
			"entry": ["src/**/*.js", "tests/**/*.js"],
			"project": ["src/**/*.js", "tests/**/*.js", "vitest.config.js", "vitest.setup.js"]
		},
		"packages/shared-http-pieces": {
			"entry": ["src/index.ts", "src/register.ts", "tests/**/*.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"],
			"ignoreDependencies": ["@discordjs/collection", "tslib"]
		},
		"packages/shared-influx-pieces": {
			"entry": ["src/index.ts", "src/register.ts", "tests/**/*.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"],
			"ignoreDependencies": ["@sapphire/pieces", "tslib"]
		},
		"packages/weather-helpers": {
			"entry": ["src/index.ts", "src/register.ts", "tests/**/*.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"],
			"ignoreDependencies": ["@sapphire/utilities", "@types/he"]
		},
		"packages/create-http-framework": {
			"entry": ["src/index.ts", "src/register.ts", "tests/**/*.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"],
			"ignoreDependencies": ["@types/handlebars", "@types/mri"]
		},
		"packages/http-framework": {
			"entry": ["src/index.ts", "src/config.ts", "src/register.ts", "tests/**/*.ts"],
			"project": ["src/**/*.ts", "tests/**/*.ts"],
			"ignoreDependencies": ["@wolfstar/http-framework-test-utils"]
		}
	}
}
