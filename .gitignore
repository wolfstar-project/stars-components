# Ignore a blackhole and the folder for development
node_modules/
.vs/
.idea/
*.iml

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
examples/**/.env

# pnpm
.pnpm-store/

# Build Artifacts
dist/
.stars/
build/
test_out/
.swc/
*.tsbuildinfo
*.zip
*.tar
*.tar.xz
*.tar.gz
*.7z
*.rar

# Ignore heapsnapshot and log files
*.heapsnapshot
*.log

# Test artifacts
coverage/
*.junit.xml
/docs-output/
# packages/cli/test/nitro-builder.test.ts creates fixtures under here; a crashed run before cleanup
# would otherwise leave these tracked.
packages/cli/test/fixtures/
# packages/{vite,nitro}-server tests/helpers.ts fixture() creates these next to src/; a crashed run
# before cleanup would otherwise leave these tracked.
packages/*/.server-test-*/

# Ignore package locks
package-lock.json

# Ignore Turbo caching
.turbo

plans/

.claude/state

# Tolgee pull staging (promoted into locales by scripts/tolgee-pull-remap.ts)
.tolgee-pull/
