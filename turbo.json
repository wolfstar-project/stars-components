{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^typecheck", "^build", "typecheck"],
			"outputs": ["dist/**"]
		},
		"check:exports": {
			"dependsOn": ["^build"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"]
		},
		"lint": {
			"dependsOn": [],
			"outputs": []
		},
		"test": {
			"dependsOn": [],
			"outputs": []
		},
		"clean": {
			"cache": false,
			"outputs": ["packages/*/dist"]
		}
	}
}
