{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.options.json",
	"compilerOptions": {
		"noEmit": true,
		"incremental": false,
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"target": "ES2022",
		"moduleResolution": "Bundler"
	},
	"include": ["packages/", "scripts/", "./vitest.config.ts"],
	"exclude": ["**/build/**", "**/dist/**", "**/node_modules/**", "**/tests/**"]
}
