{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["packages/*"],
	"entryPointStrategy": "packages",
	"exclude": ["packages/create-http-framework", "packages/i18next-type-generator"],
	"out": "docs-output/html",
	"readme": "none",
	"cleanOutputDir": true,
	"packageOptions": {
		"entryPoints": ["src/index.ts"],
		"tsconfig": "../../tsconfig.typedoc.json",
		"readme": "none",
		"excludePrivate": true,
		"excludeInternal": true
	}
}
