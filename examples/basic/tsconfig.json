{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"noEmit": true,
		"resolvePackageJsonImports": true,
		"types": ["node"],
		"paths": {
			"#lib/*": ["./src/lib/*"],
			"~/*": ["./src/*"],
			"@/*": ["./src/*"],
			"~~/*": ["./*"],
			"@@/*": ["./*"]
		}
	},
	"include": ["src/**/*.ts", ".stars/*.d.ts"],
	"exclude": ["node_modules", "dist"]
}
