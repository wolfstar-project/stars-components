DISCORD_CLIENT_ID=your_client_id_here
DISCORD_TOKEN=your_bot_token_here
DISCORD_PUBLIC_KEY=your_public_key_here

# Prefer a guild id while iterating: commands are pushed to that guild when set, globally otherwise.
REGISTRY_GUILD_ID=

HTTP_ADDRESS=0.0.0.0
HTTP_PORT=3000
HTTP_POST_PATH=/

# Leave empty to fall back to an in-memory cache, e.g. `redis://localhost:6379` with `docker compose up -d`.
REDIS_URL=
