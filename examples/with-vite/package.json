{
	"name": "with-vite",
	"version": "0.0.0",
	"private": true,
	"description": "WolfStar HTTP bot example built with Vite through experimental.enableVite",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "node ../../packages/cli/dist/cli.js build",
		"dev": "node ../../packages/cli/dist/cli.js dev",
		"start": "node --enable-source-maps dist/main.js",
		"typecheck": "node ../../packages/cli/dist/cli.js prepare && golar tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@wolfstar/env-utilities": "workspace:*",
		"@wolfstar/http-framework": "workspace:*",
		"discord-api-types": "^0.38.8"
	},
	"devDependencies": {
		"@types/node": "22.15.21",
		"@wolfstar/cli": "workspace:^",
		"golar": "^0.1.10",
		"typescript": "~7.0.2",
		"vite": "^8.3.0"
	},
	"engines": {
		"node": ">=22"
	}
}
