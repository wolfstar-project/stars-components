{
	"name": "with-i18n",
	"version": "0.0.19",
	"private": true,
	"description": "WolfStar HTTP bot example with multi-locale @wolfstar/plugin-i18next",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"build": "node ../../packages/cli/dist/cli.js build",
		"dev": "node ../../packages/cli/dist/cli.js dev",
		"start": "node --enable-source-maps dist/main.js",
		"typecheck": "node ../../packages/cli/dist/cli.js prepare && golar tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@wolfstar/env-utilities": "workspace:*",
		"@wolfstar/http-framework": "workspace:*",
		"@wolfstar/plugin-i18next": "2.0.3",
		"@wolfstar/shared-http-pieces": "workspace:*",
		"@wolfstar/start-banner": "workspace:*",
		"discord-api-types": "^0.38.8",
		"gradient-string": "^3.0.0"
	},
	"devDependencies": {
		"@types/node": "22.15.21",
		"@wolfstar/cli": "workspace:^",
		"golar": "^0.1.10",
		"tsdown": "^0.22.14",
		"typescript": "~7.0.2"
	},
	"engines": {
		"node": ">=20"
	}
}
