{
	"name": "basic-js",
	"version": "0.0.19",
	"private": true,
	"description": "Minimal WolfStar HTTP Discord bot example in plain JavaScript (ESM)",
	"type": "module",
	"main": "src/main.js",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node ../../packages/cli/dist/cli.js dev",
		"start": "node --enable-source-maps src/main.js"
	},
	"dependencies": {
		"@wolfstar/env-utilities": "workspace:*",
