DISCORD_CLIENT_ID=your_client_id_here
DISCORD_TOKEN=your_bot_token_here
DISCORD_PUBLIC_KEY=your_public_key_here

# Prefer a guild id while iterating: commands are pushed to that guild when set, globally otherwise.
REGISTRY_GUILD_ID=

# The node-server preset listens on PORT (default 3000); interactions are answered on HTTP_POST_PATH.
PORT=3000
HTTP_POST_PATH=/
