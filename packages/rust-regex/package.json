{
	"name": "@wolfstar/rust-regex",
	"version": "0.0.0",
	"description": "Transpiles regular expressions written for the Rust regex crate, the flavour Discord uses, into JavaScript RegExp",
	"keywords": [
		"automod",
		"discord",
		"regex",
		"regexp",
		"rust",
		"transpiler",
		"wolfstar"
	],
	"homepage": "https://github.com/wolfstar-project/stars-components/tree/main/packages/rust-regex",
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/rust-regex"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "vitest run",
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "golar tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.3",
		"golar": "^0.1.10",
		"tsdown": "^0.23.0",
		"typescript": "~7.0.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=20"
	}
}
