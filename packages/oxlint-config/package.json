{
	"name": "@wolfstar/oxlint-config",
	"version": "0.2.0",
	"description": "Shareable oxlint base configuration for Star Network packages",
	"keywords": [
		"config",
		"lint",
		"oxc",
		"oxlint",
		"typescript",
		"wolfstar"
	],
	"homepage": "https://github.com/wolfstar-project/stars-components/tree/main/packages/oxlint-config#readme",
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/oxlint-config"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "golar tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@wolfstar/eslint-plugin-http-framework": "workspace:*"
	},
	"devDependencies": {
		"golar": "^0.1.10",
		"oxlint": "1.82.0",
		"tsdown": "^0.23.0",
		"typescript": "~7.0.2"
	},
	"peerDependencies": {
		"oxlint": ">=1.82.0"
	},
	"engines": {
		"node": ">=20"
	}
}
