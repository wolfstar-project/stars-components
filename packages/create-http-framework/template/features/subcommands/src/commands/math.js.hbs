import { Command } from '@wolfstar/http-framework';
import { ApplicationIntegrationType, InteractionContextType } from 'discord-api-types/v10';

export class MathCommand extends Command {
	registerApplicationCommands(registry) {
		registry
			.registerChatInputCommand((builder) =>
				builder
					.setName('math')
					.setDescription('Perform basic arithmetic')
					.setIntegrationTypes(ApplicationIntegrationType.GuildInstall, ApplicationIntegrationType.UserInstall)
					.setContexts(InteractionContextType.Guild, InteractionContextType.BotDM, InteractionContextType.PrivateChannel)
			)
			.registerSubcommand(
				(builder) =>
					builder
						.setName('add')
						.setDescription('Add two numbers')
						.addIntegerOption((option) => option.setName('left').setDescription('The left operand').setRequired(true))
						.addIntegerOption((option) => option.setName('right').setDescription('The right operand').setRequired(true)),
				'add'
			)
			.registerSubcommand(
				(builder) =>
					builder
						.setName('subtract')
						.setDescription('Subtract two numbers')
						.addIntegerOption((option) => option.setName('left').setDescription('The left operand').setRequired(true))
						.addIntegerOption((option) => option.setName('right').setDescription('The right operand').setRequired(true)),
				'subtract'
			);
	}

	add(interaction, { left, right }) {
		return interaction.reply({ content: `${left} + ${right} = ${left + right}` });
	}

	subtract(interaction, { left, right }) {
		return interaction.reply({ content: `${left} - ${right} = ${left - right}` });
	}
}
