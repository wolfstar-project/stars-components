import { Command, RegisterCommand, RegisterSubcommand, RegisterSubcommandGroup } from '@wolfstar/http-framework';
import { ApplicationIntegrationType, InteractionContextType } from 'discord-api-types/v10';

@RegisterCommand((builder) =>
	builder //
		.setName('settings')
		.setDescription('Manage your settings')
		.setIntegrationTypes(ApplicationIntegrationType.GuildInstall, ApplicationIntegrationType.UserInstall)
		.setContexts(InteractionContextType.Guild, InteractionContextType.BotDM, InteractionContextType.PrivateChannel)
)
export class SettingsCommand extends Command {
	@RegisterSubcommandGroup((builder) =>
		builder //
			.setName('profile')
			.setDescription('Manage your profile settings')
	)
	@RegisterSubcommand(
		(builder) =>
			builder //
				.setName('get')
				.setDescription('View your current profile name'),
		'profile'
	)
	public profileGet(interaction: Command.ChatInputInteraction) {
		return interaction.reply({ content: 'Your profile name is not set yet.' });
	}

	@RegisterSubcommand(
		(builder) =>
			builder //
				.setName('set')
				.setDescription('Set your profile name')
				.addStringOption((option) => option.setName('name').setDescription('The new profile name').setRequired(true)),
		'profile'
	)
	public profileSet(interaction: Command.ChatInputInteraction, { name }: SettingsProfileSetOptions) {
		return interaction.reply({ content: `Your profile name is now "${name}".` });
	}

	@RegisterSubcommandGroup((builder) =>
		builder //
			.setName('notifications')
			.setDescription('Manage your notification settings')
	)
	@RegisterSubcommand(
		(builder) =>
			builder //
				.setName('enable')
				.setDescription('Enable notifications'),
		'notifications'
	)
	public notificationsEnable(interaction: Command.ChatInputInteraction) {
		return interaction.reply({ content: 'Notifications enabled.' });
	}

	@RegisterSubcommand(
		(builder) =>
			builder //
				.setName('disable')
				.setDescription('Disable notifications'),
		'notifications'
	)
	public notificationsDisable(interaction: Command.ChatInputInteraction) {
		return interaction.reply({ content: 'Notifications disabled.' });
	}
}

interface SettingsProfileSetOptions {
	name: string;
}
