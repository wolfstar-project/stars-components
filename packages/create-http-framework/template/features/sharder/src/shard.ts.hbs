{{#if i18n}}
import '@wolfstar/plugin-i18next/register';
{{/if}}
{{#if cache}}
import { createCache } from './lib/cache.js';
{{/if}}
import { envParseInteger, envParseString } from '@wolfstar/env-utilities';
import { container } from '@wolfstar/http-framework';
import { GatewayClient } from '@wolfstar/plugin-gateway';
import { ShardClient } from '@wolfstar/plugin-sharder';
import { GatewayIntentBits } from 'discord-api-types/v10';
{{#if vite}}
{{#each commands}}
import { {{className}} } from './commands/{{file}}.js';
{{/each}}
{{/if}}

const shard = new ShardClient();

const client = new GatewayClient({
{{#if i18n}}
	i18n: {
		defaultLanguageDirectory: new URL('locales', import.meta.url).pathname,
		defaultName: 'en-US'
	},
{{/if}}
{{#if cache}}
	cache: createCache(),
{{/if}}
	// The gateway shards the manager assigned to this worker, and the total across every worker.
	...shard.gatewayOptions,
	// Identifies go through the manager, which grants one per `max_concurrency` bucket across every worker.
	gateway: { buildIdentifyThrottler: () => shard.identifyThrottler },
	intents: GatewayIntentBits.Guilds
});

// Reuse the manager's `GET /gateway/bot` rather than requesting it again from every worker.
client.gateway.fetchGatewayInformation = () => shard.fetchGatewayInformation();
client.on('error', (error) => container.logger.error(error));

shard.setCloseHandler(() => client.destroy());

// The worker is ready once every gateway shard it runs is. The manager only starts the next worker once this one
// reports in, so a worker it assigned no gateway shard to (a layout can hand every shard to one channel of the
// cluster) reports in right away instead of waiting for a `shardReady` that never fires.
let pending = shard.shards.length;
if (pending === 0) void shard.ready();
client.on('shardReady', () => {
	if (--pending === 0) void shard.ready();
});
{{#if vite}}

// The bundle is a single file, so there is no `commands` directory next to it to scan: load the pieces explicitly.
{{#each commands}}
await container.stores.loadPiece({ name: '{{file}}', piece: {{className}}, store: 'commands' });
{{/each}}
{{/if}}

const address = envParseString('HTTP_ADDRESS', '0.0.0.0');
const port = envParseInteger('HTTP_PORT', {{port}});
await client.start({ listen: { address, port }{{#if vite}}, load: { baseUserDirectory: null }{{/if}} });
