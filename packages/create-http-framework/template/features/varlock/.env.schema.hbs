# Describes the environment of the bot: varlock validates it and types it, `@wolfstar/env-utilities` loads it.
# The values themselves stay in `.env` (and `.env.local`); this file only says what each variable must look like.
# @defaultRequired=true @defaultSensitive=false
# @generateTsTypes(path=src/@types/env.d.ts)
# ---

# Credentials from https://discord.com/developers/applications
# @type=string @sensitive
DISCORD_TOKEN=
# @type=string
DISCORD_PUBLIC_KEY=
# @type=string
DISCORD_CLIENT_ID=

{{#if nitro}}
# @type=port
PORT={{port}}
{{else}}
# @type=string
HTTP_ADDRESS=0.0.0.0
# @type=port
HTTP_PORT={{port}}
{{/if}}
# @type=string
HTTP_POST_PATH=/
{{#if redis}}

# @type=string
REDIS_URL=redis://localhost:6379
{{/if}}
{{#if sharder}}

# @type=number
SHARDER_CLUSTERS=2
{{/if}}
