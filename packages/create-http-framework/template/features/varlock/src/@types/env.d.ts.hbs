// A stand-in for the file varlock generates from `.env.schema` (`@generateTsTypes`), so `Env` type-checks before it has
// run. Varlock replaces it, with the same shape, the first time it loads the schema (`stars dev`, or `npx varlock load`).
export type CoercedEnvSchema = {
	DISCORD_TOKEN: string;
	DISCORD_PUBLIC_KEY: string;
	DISCORD_CLIENT_ID: string;
{{#if nitro}}
	PORT: number;
{{else}}
	HTTP_ADDRESS: string;
	HTTP_PORT: number;
{{/if}}
	HTTP_POST_PATH: string;
{{#if redis}}
	REDIS_URL: string;
{{/if}}
{{#if sharder}}
	SHARDER_CLUSTERS: number;
{{/if}}
};
