import { Command } from '@wolfstar/http-framework';
import { SlashCommandBuilder } from '@discordjs/builders';
import { MessageFlags } from 'discord-api-types/v10';
import { aiClient } from '../lib/ai.js';

export class AskCommand extends Command {
	public constructor(context: Command.LoaderContext) {
		super(context, { name: 'ask', description: 'Ask an AI a question' });
	}

	public override async chatInputRun(interaction: Command.ChatInputInteraction) {
		const question = interaction.options.getString('question', true);
		await interaction.deferReply({ flags: MessageFlags.Ephemeral });

		{{#if aiIsAnthropic}}
		const message = await aiClient.messages.create({
			model: 'claude-sonnet-4-6',
			max_tokens: 1024,
			messages: [{ role: 'user', content: question }]
		});
		const reply = message.content[0]?.type === 'text' ? message.content[0].text : 'No response.';
		{{/if}}{{#if aiIsOpenai}}
		const completion = await aiClient.chat.completions.create({
			model: 'gpt-4o-mini',
			messages: [{ role: 'user', content: question }]
		});
		const reply = completion.choices[0]?.message.content ?? 'No response.';
		{{/if}}

		return interaction.editReply({ content: reply });
	}

	public static readonly builder = new SlashCommandBuilder()
		.setName('ask')
		.setDescription('Ask an AI a question')
		.addStringOption((option) => option.setName('question').setDescription('Your question').setRequired(true));
}
