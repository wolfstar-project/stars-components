{
	"name": "@wolfstar/http-framework-decorators",
	"version": "0.0.0",
	"description": "Re-exports of the utility decorators shipped by @wolfstar/http-framework",
	"keywords": [
		"decorators",
		"discord",
		"http",
		"ts",
		"typescript",
		"wolfstar"
	],
	"homepage": "https://github.com/wolfstar-project/stars-components/tree/main/packages/http-framework-decorators",
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/http-framework-decorators"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@wolfstar/http-framework": "workspace:*",
		"tsdown": "^0.22.14",
		"typescript": "~5.8.3"
	},
	"peerDependencies": {
		"@wolfstar/http-framework": "workspace:^"
	},
	"engines": {
		"node": ">=20"
	}
}
