{
	"name": "@wolfstar/eslint-config",
	"version": "0.0.0",
	"description": "Shareable ESLint flat configuration for Star Network projects",
	"keywords": [
		"config",
		"eslint",
		"eslint-config",
		"lint",
		"typescript",
		"wolfstar"
	],
	"homepage": "https://github.com/wolfstar-project/stars-components/tree/main/packages/eslint-config#readme",
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/eslint-config"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "golar tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@wolfstar/eslint-plugin-http-framework": "workspace:*",
		"eslint-config-prettier": "^10.1.8",
		"typescript-eslint": "^8.69.0"
	},
	"devDependencies": {
		"eslint": "^10.9.1",
		"golar": "^0.1.10",
		"tsdown": "^0.22.14",
		"typescript": "~7.0.2"
	},
	"peerDependencies": {
		"eslint": "^9.0.0 || ^10.0.0",
		"typescript": ">=5.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
