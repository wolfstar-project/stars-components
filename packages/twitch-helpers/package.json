{
	"name": "@wolfstar/twitch-helpers",
	"version": "2.0.2",
	"description": "Very basic Twitch helper functions used across several ArchId bots",
	"keywords": [
		"api",
		"discord",
		"http",
		"ts",
		"typescript",
		"wolfstar",
		"yarn"
	],
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/twitch-helpers"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"watch": "tsup --watch",
		"typecheck": "tsc -p tsconfig.eslint.json",
		"lint": "oxlint src --fix",
		"prepack": "yarn build",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run"
	},
	"dependencies": {
		"@sapphire/result": "^2.8.0",
		"@wolfstar/env-utilities": "workspace:^",
		"@wolfstar/safe-fetch": "workspace:^"
	},
	"devDependencies": {
		"@favware/cliff-jumper": "^6.0.0",
		"esbuild-plugin-version-injector": "^1.2.1",
		"tsup": "^8.5.0",
		"typescript": "~5.8.3"
	},
	"engines": {
		"node": ">=18"
	}
}
