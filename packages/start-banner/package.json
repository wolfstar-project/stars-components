{
	"name": "@wolfstar/start-banner",
	"version": "2.0.2",
	"description": "A banner generator utility for your CLI",
	"keywords": [
		"api",
		"discord",
		"http",
		"ts",
		"typescript",
		"wolfstar",
		"yarn"
	],
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/start-banner"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run",
		"build": "tsup",
		"watch": "tsup --watch",
		"typecheck": "tsc -p tsconfig.eslint.json",
		"lint": "oxlint src --fix",
		"prepack": "yarn build",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run"
	},
	"devDependencies": {
		"@favware/cliff-jumper": "^6.0.0",
		"@vitest/coverage-v8": "^4.0.8",
		"tsup": "^8.5.0",
		"typescript": "~5.8.3",
		"vitest": "^4.0.8"
	},
	"engines": {
		"node": ">=18"
	}
}
