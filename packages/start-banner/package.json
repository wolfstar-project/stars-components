{
	"name": "@wolfstar/start-banner",
	"version": "2.0.8",
	"description": "A banner generator utility for your CLI",
	"keywords": [
		"api",
		"discord",
		"http",
		"pnpm",
		"ts",
		"typescript",
		"wolfstar"
	],
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/start-banner"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "vitest run",
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^4.1.11",
		"tsdown": "^0.22.14",
		"typescript": "~5.8.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=20"
	}
}
