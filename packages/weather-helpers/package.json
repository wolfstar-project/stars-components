{
	"name": "@wolfstar/weather-helpers",
	"version": "3.0.1",
	"description": "Very basic weather helper functions used across several ArchId bots",
	"keywords": [
		"api",
		"discord",
		"http",
		"pnpm",
		"ts",
		"typescript",
		"wolfstar"
	],
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/weather-helpers"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@sapphire/result": "^2.8.0",
		"@sapphire/utilities": "^3.18.2",
		"@wolfstar/safe-fetch": "workspace:^"
	},
	"devDependencies": {
		"@redstardev/unplugin-version-injector": "^0.0.2",
		"@types/he": "^1.2.3",
		"tsdown": "^0.22.2",
		"typescript": "~5.8.3"
	},
	"engines": {
		"node": ">=20"
	}
}
