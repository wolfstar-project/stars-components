{
	"name": "@wolfstar/shared-http-pieces",
	"version": "1.2.8",
	"description": "The common pieces for Star Network's HTTP-only bots",
	"keywords": [
		"api",
		"discord",
		"http",
		"pnpm",
		"ts",
		"typescript",
		"wolfstar"
	],
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/shared-http-pieces"
	},
	"files": [
		"dist/",
		"src/locales/**/*.json"
	],
	"type": "module",
	"sideEffects": [
		"./dist/register.js"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./register": {
			"types": "./dist/register.d.ts",
			"import": "./dist/register.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@discordjs/builders": "^1.14.1",
		"@discordjs/collection": "^2.1.1",
		"@sentry/node": "^10.69.0",
		"@wolfstar/env-utilities": "workspace:^",
		"@wolfstar/http-framework": "workspace:^",
		"@wolfstar/http-framework-i18n": "workspace:^",
		"discord-api-types": "^0.38.8",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"typescript": "~5.8.3"
	},
	"engines": {
		"node": ">=20"
	}
}
