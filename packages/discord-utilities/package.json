{
	"name": "@wolfstar/discord-utilities",
	"version": "0.1.1",
	"description": "Library-agnostic Discord utilities: limits, regexes, and option resolvers for raw API payloads",
	"keywords": [
		"api",
		"discord",
		"discord-api-types",
		"limits",
		"regex",
		"utilities",
		"wolfstar"
	],
	"homepage": "https://github.com/wolfstar-project/stars-components/tree/main/packages/discord-utilities",
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/discord-utilities"
	},
	"files": [
		"dist/",
		"LICENSE-SAPPHIRE.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "vitest run",
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "golar tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.3",
		"discord-api-types": "^0.38.30",
		"golar": "^0.1.10",
		"tsdown": "^0.23.0",
		"typescript": "~7.0.2",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"discord-api-types": "^0.38.30"
	},
	"engines": {
		"node": ">=20"
	}
}
