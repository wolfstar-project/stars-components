{
	"name": "@wolfstar/eslint-plugin-http-framework",
	"version": "0.0.0",
	"description": "Custom lint rules for @wolfstar/http-framework and the @wolfstar/plugin-* ecosystem, usable from both ESLint and oxlint",
	"keywords": [
		"eslint-plugin",
		"lint",
		"oxlint",
		"rules",
		"typescript",
		"wolfstar"
	],
	"homepage": "https://github.com/wolfstar-project/stars-components/tree/main/packages/eslint-plugin-http-framework#readme",
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/eslint-plugin-http-framework"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "vitest run",
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "golar tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^8.69.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"golar": "^0.1.10",
		"tsdown": "^0.22.14",
		"typescript": "~5.8.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=20"
	}
}
