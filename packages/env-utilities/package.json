{
	"name": "@wolfstar/env-utilities",
	"version": "3.0.1",
	"description": "Functional utilities for reading and parsing environmental variables",
	"keywords": [
		"api",
		"discord",
		"http",
		"pnpm",
		"ts",
		"typescript",
		"wolfstar"
	],
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/env-utilities"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": [
		"./dist/esm/setup.js",
		"./dist/cjs/setup.cjs"
	],
	"main": "dist/cjs/index.cjs",
	"module": "dist/esm/index.js",
	"types": "dist/cjs/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/esm/index.d.ts",
				"default": "./dist/esm/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.cts",
				"default": "./dist/cjs/index.cjs"
			}
		},
		"./setup": {
			"import": {
				"types": "./dist/esm/setup.d.ts",
				"default": "./dist/esm/setup.js"
			},
			"require": {
				"types": "./dist/cjs/setup.d.cts",
				"default": "./dist/cjs/setup.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"test": "vitest run",
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"dotenv": "^17.2.3",
		"dotenv-expand": "^12.0.3"
	},
	"devDependencies": {
		"@redstardev/unplugin-version-injector": "^0.0.2",
		"@vitest/coverage-v8": "^4.0.8",
		"tsdown": "^0.22.1",
		"typescript": "~5.8.3",
		"vitest": "^4.0.8"
	},
	"engines": {
		"node": ">=18"
	}
}
