{
	"name": "@wolfstar/i18next-backend",
	"version": "2.0.10",
	"description": "A fast and modern filesystem-based i18next backend for Node.js.",
	"keywords": [
		"api",
		"discord",
		"http",
		"pnpm",
		"ts",
		"typescript",
		"wolfstar"
	],
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/i18next-backend"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/cjs/index.cjs",
	"module": "dist/esm/index.js",
	"types": "dist/cjs/index.d.cts",
	"exports": {
		"import": {
			"types": "./dist/esm/index.d.ts",
			"default": "./dist/esm/index.js"
		},
		"require": {
			"types": "./dist/cjs/index.d.cts",
			"default": "./dist/cjs/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "golar tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@types/node": "22.15.21",
		"golar": "^0.1.10",
		"i18next": "^25.10.10",
		"tsdown": "^0.22.14",
		"typescript": "~7.0.2"
	},
	"engines": {
		"node": ">=20"
	}
}
