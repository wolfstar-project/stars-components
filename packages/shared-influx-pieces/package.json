{
	"name": "@wolfstar/shared-influx-pieces",
	"version": "3.0.0",
	"description": "The influx pieces for ArchId Network's HTTP-only bots",
	"keywords": [
		"api",
		"discord",
		"http",
		"pnpm",
		"ts",
		"typescript",
		"wolfstar"
	],
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/shared-influx-pieces"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": [
		"./dist/register.js"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./register": {
			"types": "./dist/register.d.ts",
			"import": "./dist/register.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -b src",
		"watch": "tsc -b src --watch",
		"typecheck": "tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@wolfstar/http-framework": "workspace:^",
		"@wolfstar/influx-utilities": "workspace:^",
		"discord-api-types": "^0.38.8",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"typescript": "~5.8.3"
	},
	"engines": {
		"node": ">=18"
	}
}
