{
	"name": "@wolfstar/cli",
	"version": "0.2.0",
	"description": "The stars command line interface for @wolfstar/http-framework projects: typed configuration, dev server, build and project info",
	"keywords": [
		"api",
		"cli",
		"discord",
		"http",
		"pnpm",
		"stars",
		"ts",
		"typescript",
		"wolfstar"
	],
	"homepage": "https://github.com/wolfstar-project/stars-components/tree/main/packages/cli",
	"bugs": {
		"url": "https://github.com/wolfstar-project/stars-components/issues"
	},
	"license": "Apache-2.0",
	"author": "@wolfstar",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wolfstar-project/stars-components.git",
		"directory": "packages/cli"
	},
	"bin": {
		"stars": "./dist/cli.js"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"sideEffects": false,
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"test": "vitest run",
		"build": "tsdown --config-loader unrun",
		"watch": "tsdown --config-loader unrun --watch",
		"typecheck": "golar tsc -p ../../tsconfig.json",
		"lint": "oxlint src --fix",
		"prepack": "pnpm run build"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"@wolfstar/http-framework": "workspace:^",
		"chokidar": "^5.0.0",
		"citty": "^0.2.2",
		"colorette": "^2.0.20",
		"ink": "^7.1.1",
		"react": "^19.2.8"
	},
	"devDependencies": {
		"@types/react": "^19.2.18",
		"@vitest/coverage-v8": "^4.1.11",
		"@xterm/headless": "^6.0.0",
		"golar": "^0.1.10",
		"tsdown": "^0.22.14",
		"typescript": "~7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"tsdown": ">=0.15.0",
		"typescript": ">=5.0.0",
		"vite": ">=6.0.0"
	},
	"peerDependenciesMeta": {
		"tsdown": {
			"optional": true
		},
		"typescript": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22"
	}
}
