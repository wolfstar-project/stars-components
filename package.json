{
	"name": "stars-components",
	"private": true,
	"description": "An HTTP-first TypeScript framework and toolkit for Discord applications",
	"type": "module",
	"scripts": {
		"clean": "node scripts/clean.mjs",
		"prepare": "husky || true",
		"lint": "oxlint packages examples benchmarks && oxfmt --check packages examples benchmarks",
		"lint:fix": "oxlint --fix packages examples benchmarks && oxfmt --write packages examples benchmarks",
		"test": "vitest run",
		"bench": "node --import tsx --import ./benchmarks/register.mjs benchmarks/index.ts",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"docs:api-json": "typedoc --options typedoc.json --json docs-output/api.json",
		"update": "pnpm update --interactive --recursive",
		"changeset": "changeset add",
		"publish": "pnpm build && node scripts/publish.mjs",
		"publish:snapshot": "node scripts/publish-snapshot.mjs",
		"tolgee:pull": "tolgee pull && node --experimental-strip-types scripts/tolgee-pull-remap.ts",
		"tolgee:push": "tolgee push --languages en",
		"tolgee:remap": "node --experimental-strip-types scripts/tolgee-pull-remap.ts",
		"tolgee:ensure-languages": "node scripts/tolgee-ensure-languages.mjs"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@changesets/cli": "^3.0.3",
		"@changesets/get-github-info": "^1.0.1",
		"@changesets/types": "^7.0.0",
		"@codspeed/tinybench-plugin": "^6.1.1",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@favware/npm-deprecate": "^2.0.0",
		"@sapphire/ts-config": "^5.0.3",
		"@swc/core": "^1.16.22",
		"@tolgee/cli": "^2.21.0",
		"@types/node": "22.15.21",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "^5.1.1",
		"cz-conventional-changelog": "^3.3.0",
		"discord-api-types": "^0.38.56",
		"golar": "^0.1.11",
		"husky": "9.1.7",
		"knip": "6.46.1",
		"nano-staged": "1.0.2",
		"oxfmt": "0.79.0",
		"oxlint": "1.94.0",
		"pkg-pr-new": "^0.0.94",
		"publint": "^0.3.25",
		"tinybench": "^6.2.4",
		"tsdown": "^0.23.7",
		"tsx": "^4.23.15",
		"turbo": "^2.11.13",
		"typedoc": "^0.28.20",
		"typescript": "~5.8.3",
		"unrun": "0.3.1",
		"vitest": "^5.1.1"
	},
	"nano-staged": {
		"*.{ts,mts,cts,tsx,mjs,cjs,js,jsx,json,jsonc,yml,yaml,md}": "oxfmt --no-error-on-unmatched-pattern",
		"*.{ts,mts,cts,tsx,mjs,cjs,js,jsx}": "oxlint --fix"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"engines": {
		"node": "^22.11 || ^24 || >=26"
	},
	"packageManager": "pnpm@12.21.0"
}
