{
	"name": "stars-components",
	"private": true,
	"description": "A collection of shared utilities for the ArchId Network",
	"type": "module",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"clean": "node scripts/clean.mjs",
		"prepare": "is-ci || husky",
		"format:ci": "oxfmt . --check",
		"format": "oxfmt .",
		"lint:ci": "pnpm format:ci && oxlint .",
		"lint": "pnpm format && oxlint . --fix --fix-dangerously",
		"lint:fix": "pnpm lint",
		"test": "pnpm -r --if-present test",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"update": "pnpm update --interactive --recursive",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm build && changeset publish --provenance"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "catalog:",
		"@changesets/cli": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@favware/npm-deprecate": "catalog:",
		"@sapphire/ts-config": "catalog:",
		"@types/node": "catalog:",
		"@types/ws": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"cz-conventional-changelog": "catalog:",
		"husky": "catalog:",
		"is-ci": "catalog:",
		"nano-staged": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"publint": "catalog:",
		"rimraf": "catalog:",
		"tsdown": "catalog:",
		"tsx": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"nano-staged": {
		"*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,jsonc,md,yml,yaml}": "oxfmt --check --no-error-on-unmatched-pattern",
		"*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": "oxlint --no-error-on-unmatched-pattern"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "pnpm@11.5.0"
}
