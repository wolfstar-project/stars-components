{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"allowJs": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"moduleResolution": "Bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"types": ["node", "vite-plugin-pwa/client"]
	},
	"include": [".vitepress/**/*.ts", ".vitepress/**/*.vue"]
}
