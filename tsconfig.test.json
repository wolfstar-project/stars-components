{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.options.json",
	"compilerOptions": {
		"noEmit": true,
		"incremental": false,
		"lib": ["ESNext"],
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["vitest/globals", "node"]
	},
	"include": ["packages/**/tests/**"]
}
